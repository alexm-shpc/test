{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only update third-party GitHub Actions to versions on the azimuth-cloud allowlist. Generated by `gha pin azimuth-cloud`, do not edit.",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Third-party GitHub Actions must be on the azimuth-cloud allowlist, so are disabled unless listed below",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "*",
        "!actions/**",
        "!github/**",
        "!azimuth-cloud/**"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "DeterminateSystems/nix-installer-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v5)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "EmilienM/devstack-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v0\\.19)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "anchore/sbom-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v0\\.24\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "anchore/scan-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v7\\.3\\.2|v7\\.4\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "ansible/ansible-lint"
      ],
      "enabled": true,
      "allowedVersions": "/^(v26\\.4\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "astral-sh/setup-uv"
      ],
      "enabled": true,
      "allowedVersions": "/^(v7\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "azure/setup-helm"
      ],
      "enabled": true,
      "allowedVersions": "/^(v3\\.5|v5\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "docker/build-push-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v7\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "docker/login-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v4\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "docker/metadata-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v6\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "docker/setup-buildx-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v4\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "docker/setup-qemu-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v4\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "dorny/paths-filter"
      ],
      "enabled": true,
      "allowedVersions": "/^(v4\\.0\\.1)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "goreleaser/goreleaser-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v7\\.2\\.3)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "hashicorp/setup-packer"
      ],
      "enabled": true,
      "allowedVersions": "/^(v3\\.2\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "helm/chart-releaser-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v1\\.6\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "helm/chart-testing-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v2\\.3\\.1|v2\\.8\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "helm/kind-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v1\\.14\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "oras-project/setup-oras"
      ],
      "enabled": true,
      "allowedVersions": "/^(v2\\.0\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "peter-evans/create-pull-request"
      ],
      "enabled": true,
      "allowedVersions": "/^(v8\\.1\\.0)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "pypa/gh-action-pypi-publish"
      ],
      "enabled": true,
      "allowedVersions": "/^(v1\\.13\\.0|v1\\.14\\.1)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "sigstore/cosign-installer"
      ],
      "enabled": true,
      "allowedVersions": "/^(v3\\.9\\.1|v4\\.0\\.0|v4\\.1\\.1)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "slackapi/slack-github-action"
      ],
      "enabled": true,
      "allowedVersions": "/^(v3\\.0\\.3)$/"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "super-linter/super-linter"
      ],
      "enabled": true,
      "allowedVersions": "/^(v8\\.6\\.0)$/"
    },
    {
      "description": "The allowlist pins SHAs, so never follow a tag which has moved to a new digest, or pin a tag which may not be allowed",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "*",
        "!actions/**",
        "!github/**",
        "!azimuth-cloud/**"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    }
  ]
}
